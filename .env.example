# 환경 변수 (ARCHITECTURE §9). lib/env.ts에서 Zod로 검증한다.
# 서버 변수는 기능별로 검증한다. 한 기능의 키가 없으면 그 기능만 동작하지 않고 빌드는 경고만 낸다.
# STRICT_ENV=1이면 하나라도 빠졌을 때 빌드가 실패한다.

NEXT_PUBLIC_SITE_URL=https://gtog2024.co.kr
NEXT_PUBLIC_GA_ID=              # 선택. 비우면 GA4를 싣지 않는다
NEXT_PUBLIC_NAVER_ANALYTICS_ID= # 선택. 둘 다 비우면 쿠키 배너도 숨긴다

# [database] 문의 저장·어드민. Vercel Marketplace의 Neon 연동이 자동으로 넣는다.
DATABASE_URL=

# [mail] 문의 알림 메일
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=            # 발신 주소 (Resend에서 인증한 도메인)
INQUIRY_NOTIFY_EMAILS=         # 수신자, 콤마 구분

# [slack] 문의 알림
SLACK_WEBHOOK_URL=

# [rateLimit] 문의·어드민 로그인 횟수 제한. Upstash 연동은 KV_REST_API_URL/TOKEN으로 넣으며 그 값도 인식한다.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# [cron] 개인정보 파기 크론
CRON_SECRET=
LEAD_RETENTION_DAYS=           # 선택. 미설정 시 파기 크론은 아무것도 지우지 않는다 (PRD §10 미결)

# [admin] 문의 관리(/admin)
ADMIN_ACCOUNTS=                # "아이디:해시" 콤마 구분. 해시는 pnpm admin:hash로 만든다
ADMIN_SESSION_SECRET=          # 32자 이상 임의 문자열. 바꾸면 모든 로그인이 끊긴다

STRICT_ENV=                    # 선택. 1이면 서버 변수 누락 시 빌드 실패
BROCHURE_TOKEN_SECRET=         # 선택 (P1, 소개서 링크 서명)
STAGING_BASIC_AUTH=            # 선택 (스테이징 전용, user:pass)
