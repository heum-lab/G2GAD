# 환경 변수 (ARCHITECTURE §9). lib/env.ts에서 Zod로 검증하며 누락 시 빌드가 실패한다.
# Preview·Staging·Production 환경마다 등록한다.

NEXT_PUBLIC_SITE_URL=https://gtog2024.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_NAVER_ANALYTICS_ID=

DATABASE_URL=
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=            # 발신 주소 (Resend에서 인증한 도메인)
INQUIRY_NOTIFY_EMAILS=         # 수신자, 콤마 구분
SLACK_WEBHOOK_URL=

RATE_LIMIT_REDIS_URL=          # 필수 (Upstash REST URL)
RATE_LIMIT_REDIS_TOKEN=        # 필수 (Upstash REST 토큰)

CRON_SECRET=                   # 개인정보 파기 크론 보호
LEAD_RETENTION_DAYS=           # 선택. 미설정 시 파기 크론은 아무것도 지우지 않는다 (PRD §10 미결)

BROCHURE_TOKEN_SECRET=         # 선택 (P1, 소개서 링크 서명)
STAGING_BASIC_AUTH=            # 선택 (스테이징 전용, user:pass)
